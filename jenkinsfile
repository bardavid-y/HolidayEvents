pipeline {
    agent any
    environment {
        // Change this to your actual Docker Hub username (all lowercase)
        DOCKER_HUB_USER = 'bardavid'
        IMAGE_NAME      = "${DOCKER_HUB_USER}/holiday-events"
    }
    stages {
        stage('checkout') {
            steps {
                echo "pull from github"
                checkout scm
            }
        }
        stage('install') {
            steps {
                echo "installing dependencies"
                sh "npm ci"
            }
        }
        stage('test') {
            steps {
                echo "running automated tests"
                sh "npm run test"
            }
        }
        stage('test connection') {
        steps {
            echo "Testing SSH connection to Proxmox Ansible server..."
            sh 'ssh -o StrictHostKeyChecking=no yossi@192.168.1.121> "echo \'SUCCESS: Connected to Proxmox\' && uptime"'
            }
        }
        stage('build and push') {
            steps {
                echo 'Building and pushing Docker image to Docker Hub'
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                    sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
                    sh "docker push ${IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }
        stage('deploy') {
            steps {
                echo "Transferring Ansible files to Proxmox server..."
                sh "scp -o StrictHostKeyChecking=no ansible/deploy.yml ansible/inventory.ini yossi@192.168.1.121:~/"
                
                echo "Triggering remote Ansible deployment..."
                sh """
                    ssh -o StrictHostKeyChecking=no yossi@192.168.1.121 \
                    'ansible-playbook -i ~/inventory.ini ~/deploy.yml -e "image_tag=${BUILD_NUMBER}"'
                """
            }
        }
    } 
    post {
        success { 
            echo "CI/CD pipeline deployment successful" 
        }
        failure { 
            echo "Failed to deploy" 
        }
    }
}