pipeline {
    agent any
    stages {
        stage('checkout') {
            steps {
                echo "pull from github"
                checkout scm
            }
        }
        stage('install') {
            steps {
                echo "installing dependencies"
                sh "npm ci"
            }
        }
        stage('build and push') {
            steps {
                echo "building docker image and pushing"
                // Added a dot '.' at the end so Docker knows where the build context is
                sh 'docker build -t holiday-class/${JOB_NAME}:${BUILD_NUMBER} .'
            }
        }
        stage('deploy') {
            steps {
                echo "deploy the new version"
                sh '''
                    docker stop holiday_class || true
                    docker rm holiday_class || true
                    docker run -d --name holiday_class -p 3000:3000 holiday_jenkins:latest
                '''
            }
        }
    } // This closes the 'stages' block properly
    post {
        success { 
            echo "CI/CD pipeline deployment successful" 
        }
        failure { 
            echo "Failed to deploy" 
        }
    }
}
