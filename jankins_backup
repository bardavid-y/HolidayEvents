pipeline {
    agent any
    stages {
        stage('checkout') {
            steps {
                echo "pull from github"
                checkout scm
            }
        }
        stage('install') {
            steps {
                echo "installing dependencies"
                sh "npm ci"
            }
        }
        stage('test') {
            steps {
                echo "running automated tests"
                sh "npm ci"       // Install Mocha/Chai or Supertest
                sh "npm run test" // Executes the script from package.json
            }
        }
        // stage('build and push') {
        //     steps {
        //         echo 'building docker image and pushing'
        //         sh "docker build -t HolidayEvents/holiday-jenkins:${BUILD_NUMBER} ."
        //     }
        // }
        stage('build and push') {
            steps {
                echo 'Building and pushing Docker image to Docker Hub'
                
                // This block securely fetches the credentials you saved in Jenkins
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                    
                    // 1. Log in to Docker Hub securely
                    sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                    
                    // 2. Build the image. Note the prefix is now your Docker Hub username.
                    sh "docker build -t ${DOCKER_USERNAME}/holiday-events:${BUILD_NUMBER} ."
                    
                    // 3. Push the image to your public or private Docker Hub repository
                    sh "docker push ${DOCKER_USERNAME}/holiday-events:${BUILD_NUMBER}"
                }
            }
        }
        stage('deploy') {
            steps {
                echo "deploy the new version"
                sh """
                    # 1. Find and force-kill ANY container currently holding port 3000
                    docker ps -q --filter "publish=3000" | xargs -r docker rm -f || true
                    
                    # 2. Force-remove the specific HolidayEvents container just in case
                    docker rm -f HolidayEvents || true
                    
                    # 3. Run the new container on port 3000:3000
                    docker run -d --name HolidayEvents -p 3000:3000 HolidayEvents/holiday-jenkins:${BUILD_NUMBER}
                    
                    # 4. Destroy old, dangling Docker images to free up disk space
                    docker image prune -f
                """
            }
        }
    } 
    post {
        success { 
            echo "CI/CD pipeline deployment successful" 
        }
        failure { 
            echo "Failed to deploy" 
        }
    }
}